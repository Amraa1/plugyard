# A 50 kW DC fast charger with two connectors.
# Try it with:
#   plugyard run examples/Chargerfile --csms ws://localhost:9000/ocpp --id CP-1
vendor: Acme
model: FastOne 50
firmware: 1.4.2
connectors:
  - { id: 1, type: CCS2, maxPower: 50kW }
  - { id: 2, type: CHAdeMO, maxPower: 50kW }
config:
  HeartbeatInterval: 300
  MeterValueSampleInterval: 60
# dataTransfer: [com.acme]    # vendor IDs whose DataTransfer requests are accepted
# voltage: 400                # the supply, for charging profile limits given in amps:
# phases: 1                   # power = amps x voltage x phases (default 230 V, 3 phases)
onEvFull: stop     # stop | suspend
startOn: tap       # tap | plug
