# yaml-language-server: $schema=https://raw.githubusercontent.com/Amraa1/plugyard/main/schemas/chargerfile.schema.json
#
# A Chargerfile describes one kind of charger. The site file makes as many
# chargers of this kind as it asks for.
vendor: Acme
model: FastOne 50
firmware: 1.4.2
ocpp: 1.6                      # the OCPP version this charger speaks
connectors:
  - { id: 1, type: CCS2, maxPower: 50kW }
  - { id: 2, type: CHAdeMO, maxPower: 50kW }
config:                        # OCPP configuration keys; the CSMS can change them
  HeartbeatInterval: 300
  MeterValueSampleInterval: 60
onEvFull: stop                 # stop | suspend
startOn: tap                   # tap | plug
